# .mkr/config — mkrdlc's own project facts. Never overwritten by an update.
# config.sh's defaults (.claude/hooks/lib/config.sh) apply to everything left
# empty below; only what actually differs from the default is stated here.
MKR_CONFIG_SCHEMA=""

# The whole suite (M3 AD-6: widened from config_test.sh alone, now that stop-checks.sh and
# mkr-gate.yml both read this value to decide whether the suite is green; M6 slice 1 widens it
# again for tests/install_test.sh, specs/M6_Installer_Spec.md §12 task 10).
MKR_TEST="bash tests/config_test.sh && bash tests/mkr_artifact_test.sh && bash tests/hooks_test.sh && bash tests/install_test.sh"

# Stop hook (stop-checks.sh) disabled for this repo (specs/StopHookToggle_Spec.md §7).
MKR_STOP_TEST_MODE="off"

MKR_COVERAGE=""
MKR_TYPECHECK=""
MKR_LINT=""
MKR_BUILD=""

# A single bash-only checkout needs no install/bootstrap step.
MKR_SETUP=""

MKR_SPECS_DIR=""
MKR_ADR_DIR=""
MKR_REVIEWS_DIR=""
MKR_AUDITS_DIR=""

MKR_PROTECTED_BRANCHES="main"
MKR_WORKTREE_POLICY="enforced"
MKR_COVERAGE_MIN=""

# The one file M0 §6 AD-0 calls a published interface from M1 onward.
